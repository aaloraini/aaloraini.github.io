---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Recognition from '../components/Recognition.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Abdulhakim Aloraini',
  url: 'https://aaloraini.github.io/',
  jobTitle: 'Product & Operations Leader',
  email: 'mailto:hkem.moh.ar@gmail.com',
  telephone: '+966563338070',
  address: { '@type': 'PostalAddress', addressLocality: 'Riyadh', addressCountry: 'SA' },
  sameAs: [
    'https://www.linkedin.com/in/abdulhakim-aloraini/',
    'https://github.com/aaloraini',
  ],
};
---

<BaseLayout schema={schema}>
  <main id="main">
    <Hero />
    <Projects />
    <Experience />
    <Recognition />
    <Skills />
    <Education />
    <Contact />
  </main>
</BaseLayout>
