---
const links = [
  { label: 'Experience', href: '/#experience' },
  { label: 'Work', href: '/#work' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__brand" href="/">
      <img class="nav__mark" src="/logo-mark.svg" alt="" width="28" height="28" />
      <span class="nav__wordmark">Aloraini<span class="nav__star" aria-hidden="true">*</span></span>
      <span class="sr-only">Abdulhakim Aloraini, home</span>
    </a>
    <div class="nav__right">
      <nav class="nav__links" aria-label="Primary">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <button class="nav__theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <svg class="nav__icon nav__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="nav__icon nav__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Runs on the initial load and after every ClientRouter navigation;
  // the swapped-in button is a fresh element and needs rebinding.
  function setupThemeToggle() {
    const btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    const root = document.documentElement;
    // Dark is the default: only an explicit OS light preference flips it.
    const systemLight = () => window.matchMedia('(prefers-color-scheme: light)').matches;
    const effective = () => root.dataset.theme || (systemLight() ? 'light' : 'dark');
    const sync = () => btn.setAttribute('aria-pressed', String(effective() === 'dark'));
    sync();
    btn.addEventListener('click', () => {
      const next = effective() === 'dark' ? 'light' : 'dark';
      // __applyTheme (BaseLayout head) also syncs the theme-color metas
      if (window.__applyTheme) window.__applyTheme(next);
      else root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      sync();
    });
  }
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    -webkit-backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  /* Reading progress: a thin accent line that tracks page scroll.
     Only rendered in browsers with scroll-driven animations. */
  @supports (animation-timeline: scroll()) {
    .nav::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1.5px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
      /* longhands: the animation shorthand cannot express a timeline */
      animation-name: nav-progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
    }
    @keyframes nav-progress {
      to { transform: scaleX(1); }
    }
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }
  /* The wordmark is ALORAINI* — the asterisk resolves to the footnote
     in the page footer ("hakim — the wise one"). */
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nav__mark {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius);
    flex: none;
  }
  .nav__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .nav__star { color: var(--accent); }
  .nav__right {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
  }
  .nav__links {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .nav__links a {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav__links a:hover { color: var(--ink); }
  .nav__links a:hover::after { transform: scaleX(1); }

  /* Tool-like, not a pill: 3px corners on a hairline square. */
  .nav__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: var(--radius-btn);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .nav__theme:hover { border-color: var(--accent); color: var(--accent); }
  .nav__icon { width: 1.05rem; height: 1.05rem; }

  /* Icon reflects the effective theme (mirror of the token rules).
     Dark is the default, so the sun — "switch to light" — shows first. */
  .nav__icon--sun { display: block; }
  .nav__icon--moon { display: none; }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .nav__icon--sun { display: none; }
    :root:not([data-theme='dark']) .nav__icon--moon { display: block; }
  }
  :root[data-theme='light'] .nav__icon--sun { display: none; }
  :root[data-theme='light'] .nav__icon--moon { display: block; }
  :root[data-theme='dark'] .nav__icon--sun { display: block; }
  :root[data-theme='dark'] .nav__icon--moon { display: none; }

  @media (max-width: 460px) {
    .nav__wordmark { font-size: 0.95rem; }
    .nav__mark { width: 1.5rem; height: 1.5rem; }
    .nav__links { gap: 1rem; }
    .nav__links a { font-size: 0.66rem; letter-spacing: 0.08em; }
    .nav__right { gap: 0.85rem; }
  }
</style>
