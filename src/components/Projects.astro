---
import { featured, more } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="section work" id="work">
  <div class="wrap">
    <h2 class="eyebrow"><span class="num" aria-hidden="true">Log 01</span> Selected work <span class="bar" aria-hidden="true"></span></h2>

    <div class="stack">
      {featured.map((project, i) => (
        <div class="stack__item" style={`--i:${i}`} data-reveal>
          <ProjectCard project={project} index={i} />
        </div>
      ))}
    </div>

    <h3 class="more__heading">Project log</h3>
    <ul class="more">
      {more.map((p, i) => (
        <li class="more__item" data-reveal>
          <span class="more__entry" aria-hidden="true">{String(featured.length + i + 1).padStart(2, '0')}</span>
          <div class="more__body">
            <div class="more__top">
              <h4 class="more__name">{p.name}</h4>
              {p.status && <span class="badge">{p.status}</span>}
            </div>
            <p class="more__tagline">{p.tagline}</p>
            <ul class="more__tags">
              {p.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
          {p.links && p.links.length > 0 && (
            <div class="more__links">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span></a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Sticky card-stack: each card pins, the next slides up and stacks over it.
     Pure native vertical scroll; degrades to a plain list on small screens. */
  .stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 4.5rem);
  }
  .stack__item {
    position: sticky;
    top: calc(4.5rem + var(--i) * 0.9rem);
  }
  @media (max-width: 760px) {
    .stack__item { position: static; }
    .stack { gap: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack__item { position: static; }
  }

  .more__heading {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
    margin-top: clamp(3rem, 7vw, 5rem);
    margin-bottom: 1.5rem;
  }
  /* Logbook rows: a sand entry number, the entry, then its links. */
  .more { list-style: none; }
  .more__item {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 3vw, 2rem);
    flex-wrap: wrap;
    padding-block: 1.3rem;
    border-top: var(--border-hair) solid var(--line);
  }
  .more__item:last-child { border-bottom: var(--border-hair) solid var(--line); }
  .more__entry {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--sand);
    padding-top: 0.35rem;
    min-width: 2.5rem;
    flex: none;
  }
  .more__body { flex: 1; min-width: 220px; }
  .more__top { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .more__name { font-size: 1.15rem; letter-spacing: -0.01em; }
  .more__tagline { color: var(--muted); font-size: 0.95rem; margin-top: 0.3rem; }
  .more__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.85rem; }
  .more__links { display: flex; flex-wrap: wrap; gap: 1rem; padding-top: 0.35rem; }
  .more__links a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .more__links a:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 560px) {
    .more__item { gap: 0.85rem; }
    .more__entry { min-width: 0; padding-top: 0; }
  }
</style>
