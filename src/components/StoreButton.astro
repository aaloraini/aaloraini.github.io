---
import type { Link } from '../data/projects';

/* A solid badge-style button for the places a product can be obtained:
   the App Store, the Microsoft Store, or its own site. The icon is chosen
   from the link label, so data files stay plain { label, href } pairs and
   the three call sites (project card, case-study header, case-study footer)
   share one button. */

interface Props {
  link: Link;
}

const { link } = Astro.props;

const applePath =
  'M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z';

const kind =
  link.label === 'App Store' ? 'apple' : link.label === 'Microsoft Store' ? 'windows' : 'web';

const label =
  kind === 'apple'
    ? 'View on the App Store'
    : kind === 'windows'
      ? 'View on the Microsoft Store'
      : `Visit the ${link.label.toLowerCase()}`;
---

<a class="storebtn" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={label}>
  {kind === 'apple' && (
    <svg class="storebtn__icon storebtn__icon--apple" viewBox="0 0 384 512" aria-hidden="true">
      <path fill="currentColor" d={applePath} />
    </svg>
  )}
  {kind === 'windows' && (
    <svg class="storebtn__icon" viewBox="0 0 16 16" aria-hidden="true">
      <path fill="currentColor" d="M0 0h7v7H0zM9 0h7v7H9zM0 9h7v7H0zM9 9h7v7H9z" />
    </svg>
  )}
  {kind === 'web' && (
    <svg
      class="storebtn__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9.5" />
      <path d="M2.5 12h19M12 2.5c2.5 2.6 3.8 5.9 3.8 9.5S14.5 18.9 12 21.5C9.5 18.9 8.2 15.6 8.2 12S9.5 5.1 12 2.5z" />
    </svg>
  )}
  <span>{link.label}</span>
</a>

<style>
  .storebtn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--badge-bg);
    color: var(--badge-fg);
    padding: 0.6rem 1rem;
    border: var(--border-mid) solid var(--badge-bg);
    border-radius: var(--radius-btn);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-btn);
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    position: relative;
    z-index: 1;
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .storebtn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  /* One optical size for every mark: the Apple glyph is tall and narrow, so
     it is sized by height while the square marks are sized by width. */
  .storebtn__icon {
    width: 14px;
    height: 14px;
    display: block;
    flex: none;
  }
  .storebtn__icon--apple {
    width: auto;
    height: 15px;
  }
</style>
