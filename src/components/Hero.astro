---
const stats = [
  { k: '3,000+', v: 'emergency vehicles equipped nationwide' },
  { k: '1.8M+', v: 'people served during Hajj 1445' },
  { k: '3', v: 'apps shipped on the App Store' },
];
---

<header class="hero">
  <div class="wrap">
    <p class="kicker">
      <span class="kicker__dot" aria-hidden="true"></span>Product · Operations · Engineering
      <span class="kicker__coords">· Riyadh 24.7136° N, 46.6753° E</span>
      <span class="kicker__status">· Status: open to the Gulf &amp; remote</span>
    </p>
    <h1 class="name">
      <span class="name__line"><span class="name__word">Abdulhakim</span></span>
      <span class="name__line"><span class="name__word name__word--stroke">Aloraini</span></span>
    </h1>

    <div class="lede-row">
      <p class="tagline"><em>I lead products,</em> and build them.</p>
      <p class="lede">
        I run delivery end to end and build my own apps and hardware, so I understand the
        technical detail deeply enough to make the right calls and communicate clearly with
        both engineers and stakeholders.
      </p>
      <p class="hero__about">
        Based in Riyadh, finishing a B.Eng. in Electrical &amp; Electronics Engineering, and
        targeting technical product management roles across Saudi Arabia, the Gulf, and remote.
      </p>
    </div>

    <div class="cta">
      <a class="btn btn--solid" href="#work">View work</a>
      <a class="btn btn--ghost" href="#contact">Get in touch</a>
    </div>

    <dl class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dt>{s.k}</dt>
          <dd>{s.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4rem);
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .kicker__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  /* Coordinates and a status line stand in for a tagline. */
  .kicker__coords,
  .kicker__status { color: var(--faint); }
  .name {
    font-size: clamp(3.25rem, 13vw, 10.5rem);
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .name__line {
    display: block;
    overflow: hidden;
  }
  .name__word { display: inline-block; }
  /* Editorial filled/outline pairing on the surname */
  .name__word--stroke {
    color: transparent;
    -webkit-text-stroke: clamp(1.5px, 0.022em, 3px) var(--ink);
  }
  @supports not (-webkit-text-stroke: 1px black) {
    .name__word--stroke { color: var(--ink); }
  }

  /* Entrance cascade: kicker, name lines rise out of their masks, then
     the lede, CTAs, and stats follow. Static under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .kicker {
      opacity: 0;
      animation: hero-fade 0.6s ease 0s forwards;
    }
    .name__word {
      transform: translateY(115%);
      animation: hero-rise 0.75s cubic-bezier(0.22, 0.7, 0.2, 1) 0.08s forwards;
    }
    .name__line:nth-child(2) .name__word { animation-delay: 0.18s; }
    .lede-row,
    .cta,
    .stats {
      opacity: 0;
      transform: translateY(0.6rem);
      animation: hero-fade 0.65s ease 0.45s forwards;
    }
    .cta { animation-delay: 0.55s; }
    .stats { animation-delay: 0.65s; }
  }
  @keyframes hero-rise {
    to { transform: translateY(0); }
  }
  @keyframes hero-fade {
    to { opacity: 1; transform: none; }
  }
  .lede-row {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 64ch;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    letter-spacing: -0.02em;
  }
  .tagline em { color: var(--accent); font-style: normal; }
  .lede {
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    max-width: 56ch;
  }
  .hero__about {
    font-size: 0.98rem;
    color: var(--muted);
    max-width: 56ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  /* Instrument readings, not marketing: display-weight values over
     mono, uppercase captions. */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: var(--border-mid) solid var(--line-strong);
    padding-top: 1.75rem;
  }
  .stat dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
  }
  .stat dd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--faint);
    margin-top: 0.5rem;
    max-width: 26ch;
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr; gap: 1.1rem; }
    .stat { display: flex; align-items: baseline; gap: 1rem; }
    .stat dt { font-size: 2rem; }
    .stat dd { margin-top: 0; }
  }
</style>

<script>
  // Count the hero stats up from zero the first time they scroll into
  // view. The real values are server-rendered, so no-JS, reduced-motion,
  // and crawlers all see the finished numbers.
  function initCountUp() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    document.querySelectorAll('.stats dt').forEach((el) => {
      const match = (el.textContent || '').trim().match(/^([\d.,]+)(.*)$/);
      if (!match) return;
      const target = parseFloat(match[1].replace(/,/g, ''));
      const decimals = (match[1].split('.')[1] || '').length;
      const grouped = match[1].includes(',');
      const suffix = match[2] || '';
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const start = performance.now();
        const duration = 1100;
        const frame = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          let value = (target * eased).toFixed(decimals);
          if (grouped) {
            value = Number(value).toLocaleString('en-US', {
              minimumFractionDigits: decimals,
            });
          }
          el.textContent = value + suffix;
          if (p < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }, { threshold: 0.6 });
      io.observe(el);
    });
  }
  document.addEventListener('astro:page-load', initCountUp);
</script>
