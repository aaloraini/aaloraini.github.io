---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const n = String(index + 1).padStart(2, '0');
const appStore = project.links?.find((l) => l.label === 'App Store');
const otherLinks = project.links?.filter((l) => l.label !== 'App Store') ?? [];
const applePath =
  'M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z';
---

<article class:list={['pcard', { 'pcard--linked': project.caseStudy }]}>
  <div class="pcard__aside">
    {project.icon && project.caseStudy ? (
      <img class="pcard__icon" src={project.icon.src} alt={project.icon.alt} width="104" height="104" loading="lazy" decoding="async" transition:name={`icon-${project.caseStudy}`} />
    ) : project.icon ? (
      <img class="pcard__icon" src={project.icon.src} alt={project.icon.alt} width="104" height="104" loading="lazy" decoding="async" />
    ) : (
      <span class="pcard__num">{n}</span>
    )}
    {project.category && <span class="badge">{project.category}</span>}
    {appStore && (
      <a class="appstore" href={appStore.href} target="_blank" rel="noopener noreferrer" aria-label="View on the App Store">
        <svg viewBox="0 0 384 512" width="15" height="20" aria-hidden="true"><path fill="currentColor" d={applePath} /></svg>
        <span>App Store</span>
      </a>
    )}
  </div>

  <div class="pcard__main">
    <h3 class="pcard__name">{project.name}</h3>
    <p class="pcard__tagline">{project.tagline}</p>
    {project.focus && <p class="pcard__focus">{project.focus}</p>}
    {project.description && <p class="pcard__desc">{project.description}</p>}

    {project.caseStudy && (
      <a class="pcard__case" href={`/work/${project.caseStudy}`} aria-label={`Read the ${project.name} case study`}>
        Read the case study
        <span class="pcard__case-arrow" aria-hidden="true">&rarr;</span>
      </a>
    )}

    <ul class="pcard__tags">
      {project.tags.map((t) => <li class="tag">{t}</li>)}
    </ul>

    {otherLinks.length > 0 && (
      <div class="pcard__links">
        {otherLinks.map((l) => (
          <a class="pcard__link" href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  /* Depth is the border and the surface step, never a shadow. */
  .pcard {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    background: var(--card);
    border: var(--border-hair) solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.75rem, 4vw, 3rem);
  }
  @media (min-width: 760px) {
    .pcard {
      grid-template-columns: 220px 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
  }

  .pcard__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .pcard__icon {
    width: clamp(76px, 12vw, 104px);
    height: auto;
    border-radius: 22.5%;
    border: var(--border-hair) solid var(--line);
    transition: transform var(--dur-med) var(--ease);
  }
  .pcard--linked:hover .pcard__icon { transform: rotate(-3deg) scale(1.04); }
  .pcard__num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    color: var(--sand);
  }

  .pcard__name { font-size: clamp(1.6rem, 3.2vw, 2.4rem); letter-spacing: -0.025em; line-height: 1.1; }
  .pcard__tagline {
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    margin-top: 0.4rem;
  }
  /* The field-log line: sand, mono, wide-tracked. */
  .pcard__focus {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--sand);
    margin-top: 0.9rem;
  }
  .pcard__desc { color: var(--muted); margin-top: 0.85rem; max-width: 60ch; }

  /* Case-study cards are fully clickable; the ghost button is the affordance. */
  .pcard--linked {
    position: relative;
    transition: border-color var(--dur-med) var(--ease), transform var(--dur-med) var(--ease);
  }
  .pcard--linked:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  /* The brand signature: a dashed outline that solidifies to moss. */
  .pcard__case {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding: 0.85rem 1.5rem;
    border: var(--border-mid) dashed var(--line-strong);
    border-radius: var(--radius-btn);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-btn);
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    line-height: 1;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      gap var(--dur-fast) var(--ease);
  }
  .pcard__case-arrow { transition: transform var(--dur-fast) var(--ease); }
  /* Hovering anywhere on the card solidifies the outline and slides the arrow */
  .pcard--linked:hover .pcard__case {
    border-style: solid;
    border-color: var(--accent);
    color: var(--accent);
    gap: 0.75rem;
  }
  .pcard--linked:hover .pcard__case-arrow { transform: translateX(3px); }
  .pcard__case:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* Stretch the link across the whole card so the entire card is the click target */
  .pcard__case::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .pcard__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.25rem;
  }

  .pcard__links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 1.4rem; position: relative; z-index: 1; }
  .appstore {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--badge-bg);
    color: var(--badge-fg);
    padding: 0.6rem 1rem;
    border: var(--border-mid) solid var(--badge-bg);
    border-radius: var(--radius-btn);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-btn);
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    line-height: 1;
    position: relative;
    z-index: 1;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .appstore:hover { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .appstore svg { width: 14px; height: auto; display: block; }
  .pcard__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .pcard__link:hover { color: var(--accent); border-color: var(--accent); }
</style>
